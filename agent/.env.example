# Copy to agent/.env and fill in your values. Never commit the real file.
ADAFRUIT_IO_USERNAME=your_username_here
ADAFRUIT_IO_KEY=your_aio_key_here

# Optional overrides
# PUBLISHER_FEED=claude-portal.snapshot
# PUBLISHER_INTERVAL=30

# Weekly reset schedule — set these to match your Claude plan's billing week.
# WEEK_RESET_WEEKDAY=4          # day the week resets: 0=Mon 1=Tue … 4=Fri 5=Sat 6=Sun
# WEEK_RESET_HOUR=9             # hour of day the reset fires (24h clock, local to WEEK_RESET_TZ)
# WEEK_RESET_TZ=Europe/Dublin   # IANA timezone name (e.g. Europe/Dublin, America/New_York)
#
# Weekly token limit for the % bar on the WEEK screen.
# Set to your plan's weekly token allowance; leave at 0 to hide the percentage.
# WEEK_LIMIT_TOKENS=0
