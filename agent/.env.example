# Copy to agent/.env and fill in your values. Never commit the real file.
ADAFRUIT_IO_USERNAME=your_username_here
ADAFRUIT_IO_KEY=your_aio_key_here

# Optional overrides
# PUBLISHER_FEED=claude-portal.snapshot
# PUBLISHER_INTERVAL=30

# Claude plan — sets calibrated defaults for session and weekly token limits.
# Supported values: pro, max5, max20  (max5/max20 are 5×/20× pro; unverified estimates)
# Override individual limits with SESSION_LIMIT_TOKENS / WEEK_LIMIT_TOKENS below.
# CLAUDE_PLAN=pro

# Token limits — how to calibrate:
#   1. Leave both unset (or set CLAUDE_PLAN) and restart the agent.
#   2. Watch the serial console; each message prints:
#        SESSION tokens=N   (in+out+cache_creation for the 5h window)
#        WEEK    total=N    (in+out+cache_creation since weekly reset)
#   3. Cross-reference with Claude.ai usage panel percentages P_session and P_week.
#   4. Set SESSION_LIMIT_TOKENS = session_tokens / (P_session / 100)
#      Set WEEK_LIMIT_TOKENS    = week_total    / (P_week    / 100)
#
# Leave at 0 to hide the % bar for that screen (countdown still shows).
# SESSION_LIMIT_TOKENS=0
# WEEK_LIMIT_TOKENS=0

# Weekly reset schedule — match your Claude plan's billing week.
# WEEK_RESET_WEEKDAY=4          # 0=Mon 1=Tue … 4=Fri 5=Sat 6=Sun
# WEEK_RESET_HOUR=9             # hour of reset in WEEK_RESET_TZ (24h clock)
# WEEK_RESET_TZ=Europe/Dublin   # IANA timezone (e.g. America/New_York, Europe/London)
